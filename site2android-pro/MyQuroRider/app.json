{
  "name": "MyQuroRider",
  "displayName": "MyQuroRider",
  "expo": {
    "name": "MyQuro Rider",
    "slug": "myquro-rider-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myquroriderapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myquro.rider"
    },
    "android": {
      "package": "com.myquro.rider",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "FOREGROUND_SERVICE",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow MyQuro Rider to access your location to show live pickup and dropoff routes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
